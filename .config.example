# =============================================================================
# Streaming Pipeline Configuration Example
# =============================================================================
# Copy this file to .config and fill in your actual values
# The deploy script will generate .env from this configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Infrastructure
# -----------------------------------------------------------------------------
HOST_IP=192.168.1.202

# -----------------------------------------------------------------------------
# Storage & Data Lake Choice
# -----------------------------------------------------------------------------
STORAGE_TYPE=s3        # Options: "garage" or "s3"
DATALAKE_FORMAT=iceberg # Options: "paimon" or "iceberg"

# -----------------------------------------------------------------------------
# S3 Configuration (only needed if STORAGE_TYPE=s3)
# -----------------------------------------------------------------------------
S3_ENDPOINT=https://s3.amazonaws.com                    # AWS S3 or S3-compatible endpoint
S3_ACCESS_KEY=your-access-key-here                     # S3 access key
S3_SECRET_KEY=your-secret-key-here                     # S3 secret key
S3_BUCKET=your-bucket-name                             # S3 bucket name or bucket/prefix
S3_PATH_STYLE_ACCESS=false                             # false for AWS S3, true for garage/minio

# -----------------------------------------------------------------------------
# Notes:
# -----------------------------------------------------------------------------
# - For garage storage, S3_* settings are auto-generated
# - For paimon format, PostgreSQL catalog is used
# - For iceberg format, Hadoop catalog with S3 storage is used
# - All warehouse paths are computed automatically from S3_BUCKET:
#     CHECKPOINTS_DIR = s3://${S3_BUCKET}/checkpoints
#     ICEBERG_WAREHOUSE = s3a://${S3_BUCKET}/flink/iceberg
#     PAIMON_WAREHOUSE = s3://${S3_BUCKET}/paimon
# - SQL files use __CHECKPOINTS_DIR__ placeholder, replaced at runtime by run.sh
# =============================================================================