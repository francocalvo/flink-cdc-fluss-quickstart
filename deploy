#!/bin/bash
set -euo pipefail

# =============================================================================
# Unified Deployment Script for Streaming Pipeline
# =============================================================================
# Supports all 4 combinations:
# - Storage: garage | s3
# - Format: paimon | iceberg
#
# Usage: ./deploy [--storage=garage|s3] [--format=paimon|iceberg] [--build]
# =============================================================================

# --- Host Configuration ---
REMOTE_SERVER="calvo@192.168.1.202"
REMOTE_DIR="/mefitis/streaming"

# --- Load Configuration ---
if [ ! -f ".config" ]; then
    echo "❌ ERROR: .config file not found!"
    echo "   Copy .config.example to .config and fill in your settings."
    exit 1
fi

# Load configuration
source .config

# Allow command line overrides
STORAGE_TYPE="${STORAGE_TYPE:-garage}"
DATALAKE_FORMAT="${DATALAKE_FORMAT:-paimon}"
BUILD_FLAG=""

# --- Parse command line arguments ---
for arg in "$@"; do
    case $arg in
        --storage=*)
            STORAGE_TYPE="${arg#*=}"
            if [[ "$STORAGE_TYPE" != "garage" && "$STORAGE_TYPE" != "s3" ]]; then
                echo "❌ ERROR: Invalid storage type '$STORAGE_TYPE'. Use 'garage' or 's3'."
                exit 1
            fi
            ;;
        --format=*)
            DATALAKE_FORMAT="${arg#*=}"
            if [[ "$DATALAKE_FORMAT" != "paimon" && "$DATALAKE_FORMAT" != "iceberg" ]]; then
                echo "❌ ERROR: Invalid format '$DATALAKE_FORMAT'. Use 'paimon' or 'iceberg'."
                exit 1
            fi
            ;;
        --build)
            BUILD_FLAG="--build"
            ;;
        *)
            echo "❌ ERROR: Unknown argument: $arg"
            echo "Usage: $0 [--storage=garage|s3] [--format=paimon|iceberg] [--build]"
            exit 1
            ;;
    esac
done

echo "🚀 Starting Unified Deployment Script..."
echo "🗄️  Storage Backend: $STORAGE_TYPE"
echo "📊 Data Lake Format: $DATALAKE_FORMAT"
if [ -n "$BUILD_FLAG" ]; then
    echo "🔨 Force Build: Enabled"
fi

# --- Environment Setup ---
echo "🔧 Generating .env from configuration..."

if [ "$STORAGE_TYPE" = "garage" ]; then
    echo "🏠 Configuring for Garage storage backend..."
elif [ "$STORAGE_TYPE" = "s3" ]; then
    echo "☁️  Configuring for S3 storage backend..."

    # Validate S3 credentials
    if [ -z "$S3_ACCESS_KEY" ] || [ -z "$S3_SECRET_KEY" ] || [ -z "$S3_BUCKET" ]; then
        echo "❌ ERROR: S3 storage requires S3_ACCESS_KEY, S3_SECRET_KEY, and S3_BUCKET in .config"
        exit 1
    fi

    # Validate AWS_ACCOUNT_ID for Iceberg REST catalog
    if [ "$DATALAKE_FORMAT" = "iceberg" ] && [ -z "$AWS_ACCOUNT_ID" ]; then
        echo "❌ ERROR: Iceberg with S3 requires AWS_ACCOUNT_ID in .config for Glue REST catalog"
        exit 1
    fi
fi

# Generate complete .env file from scratch
cat > .env << EOF
# =============================================================================
# Generated Environment Configuration for Streaming Pipeline
# =============================================================================
# Generated from .config by deploy script - DO NOT EDIT MANUALLY
# =============================================================================

# -----------------------------------------------------------------------------
# Infrastructure Configuration
# -----------------------------------------------------------------------------
HOST_IP=${HOST_IP}
POSTGRES_CATALOG_PORT=5433
POSTGRES_SOURCE_PORT=5432

# -----------------------------------------------------------------------------
# Storage Backend Configuration
# -----------------------------------------------------------------------------
STORAGE_TYPE=${STORAGE_TYPE}
DATALAKE_FORMAT=${DATALAKE_FORMAT}

# S3/Garage Configuration
S3_ENDPOINT=${S3_ENDPOINT:-http://192.168.1.202:3900}
S3_ACCESS_KEY=${S3_ACCESS_KEY:-}
S3_SECRET_KEY=${S3_SECRET_KEY:-}
S3_BUCKET=${S3_BUCKET:-warehouse}
S3_PATH_STYLE_ACCESS=${S3_PATH_STYLE_ACCESS:-true}
AWS_REGION=${AWS_REGION:-us-east-2}
AWS_ACCOUNT_ID=${AWS_ACCOUNT_ID:-}

# Computed warehouse paths
S3_BASE=s3://${S3_BUCKET}
PAIMON_WAREHOUSE=s3://${S3_BUCKET}/paimon
ICEBERG_WAREHOUSE=s3a://${S3_BUCKET}/flink/iceberg
CHECKPOINTS_DIR=s3://${S3_BUCKET}/checkpoints

# Version configuration
PAIMON_VERSION=0.8.0
ICEBERG_VERSION=1.9.1
FLUSS_TAG=0.8.0-incubating
PGJDBC_VERSION=42.7.8

# Database Configuration
POSTGRES_CATALOG_USER=root
POSTGRES_CATALOG_PASSWORD=root
POSTGRES_CATALOG_DB=paimon_catalog
EOF

# Add format-specific configuration
if [ "$DATALAKE_FORMAT" = "paimon" ]; then
    echo "📋 Adding Paimon configuration..."
    cat >> .env << EOF

# Paimon Configuration
PAIMON_METASTORE=jdbc
PAIMON_URI=jdbc:postgresql://\${HOST_IP}:\${POSTGRES_CATALOG_PORT}/\${POSTGRES_CATALOG_DB}
PAIMON_USER=\${POSTGRES_CATALOG_USER}
PAIMON_PASSWORD=\${POSTGRES_CATALOG_PASSWORD}
PAIMON_CATALOG_KEY=paimon_catalog

# Iceberg Configuration (dummy values for paimon to avoid YAML syntax errors)
ICEBERG_TYPE=dummy
ICEBERG_WAREHOUSE_PATH=dummy
ICEBERG_ENDPOINT=dummy
ICEBERG_ACCESS_KEY=dummy
ICEBERG_SECRET_KEY=dummy
ICEBERG_PATH_STYLE=dummy
EOF

elif [ "$DATALAKE_FORMAT" = "iceberg" ]; then
    echo "❄️  Adding Iceberg configuration..."
    cat >> .env << EOF

# Iceberg Configuration
ICEBERG_TYPE=rest
ICEBERG_WAREHOUSE_PATH=\${ICEBERG_WAREHOUSE}
ICEBERG_ENDPOINT=\${S3_ENDPOINT}
ICEBERG_ACCESS_KEY=\${S3_ACCESS_KEY}
ICEBERG_SECRET_KEY=\${S3_SECRET_KEY}
ICEBERG_PATH_STYLE=\${S3_PATH_STYLE_ACCESS}
AWS_ACCOUNT_ID=\${AWS_ACCOUNT_ID}

# Paimon Configuration (dummy values for iceberg to avoid YAML syntax errors)
PAIMON_METASTORE=dummy
PAIMON_URI=dummy
PAIMON_USER=dummy
PAIMON_PASSWORD=dummy
PAIMON_CATALOG_KEY=dummy
EOF
fi

echo "📤 1. Syncing Local Changes to Remote Server..."
bash sync.sh

echo "🌐 2. Connecting to $REMOTE_SERVER for Remote Environment Reset..."

if [ "$STORAGE_TYPE" = "garage" ]; then
    # Garage setup - need to provision garage and generate credentials
    ssh -t "$REMOTE_SERVER" "sudo nix-shell -p jq --run '
        cd $REMOTE_DIR
        set -euo pipefail

        echo \"-----------------------------------\"
        echo \"------- SUBSTEP: CLEANUP ----------\"
        echo \"-----------------------------------\"
        echo \"🛑 Stopping all services...\"

        docker compose -f flink-cdc/docker-compose.yaml down -v || true
        docker compose -f fluss/docker-compose.yaml down -v || true
        docker compose -f garage/docker-compose.yaml down -v || true
        docker compose -f postgres-catalog/docker-compose.yaml down -v || true
        docker compose -f postgres-source/docker-compose.yaml down -v || true

        echo \"🧹 Pruning Docker volumes...\"
        docker volume prune -f

        echo \"-----------------------------------------\"
        echo \"------- SUBSTEP: DATA DELETION ----------\"
        echo \"-----------------------------------------\"
        echo \"🗑️ Deleting ALL data directories...\"
        find . -name \"data\" -type d -exec rm -rf {} +

        echo \"🧹 Removing old .env file before provisioning...\"
        rm -f garage/.env

        echo \"----------------------------------------\"
        echo \"------- SUBSTEP: INFRA REBOOT ----------\"
        echo \"----------------------------------------\"
        echo \"🐘 Starting Foundation Services...\"

        # Always start source postgres and garage
        docker compose -f postgres-source/docker-compose.yaml up -d
        docker compose -f garage/docker-compose.yaml up -d

        # Only start catalog postgres for Paimon (Iceberg uses Hadoop catalog)
        if [ \"$DATALAKE_FORMAT\" = \"paimon\" ]; then
            echo \"📋 Starting PostgreSQL catalog for Paimon...\"
            docker compose -f postgres-catalog/docker-compose.yaml up -d
        else
            echo \"❄️  Skipping PostgreSQL catalog for Iceberg (uses Hadoop catalog)...\"
        fi

        echo \"⏳ Waiting 5s for Garage S3 API...\"
        sleep 5

        echo \"-----------------------------------------\"
        echo \"------- SUBSTEP: GARAGE CONFIG ----------\"
        echo \"-----------------------------------------\"
        echo \"🔑 Provisioning Garage S3 buckets and keys...\"

        cd garage && bash ./garage.sh
    '"

    echo "📥 3. Fetching Credentials and Updating Local Environment..."
    # Fetch the freshly generated .env from the server back to your local machine
    scp "$REMOTE_SERVER:$REMOTE_DIR/garage/.env" ./garage/.env

    if [ -f "garage/.env" ]; then
        # Load garage credentials and update our .env
        source garage/.env

        # Update .env with garage credentials
        sed -i '' "s/S3_ACCESS_KEY=.*/S3_ACCESS_KEY=${GARAGE_ACCESS_KEY}/" .env
        sed -i '' "s/S3_SECRET_KEY=.*/S3_SECRET_KEY=${GARAGE_SECRET_KEY}/" .env

        echo "✅ Garage credentials updated in .env"
    else
        echo "❌ ERROR: garage/.env was not fetched. Aborting." && exit 1
    fi

else
    # S3 setup - clean AWS resources locally first
    echo "-------------------------------------------"
    echo "------- LOCAL: AWS CLEANUP ---------------"
    echo "-------------------------------------------"
    echo "☁️  Cleaning up AWS resources locally..."

    # S3 cleanup - requires s3:ListBucket permission
    echo "⚠️  S3 cleanup requires s3:ListBucket permission on bucket: ${S3_BUCKET}"
    read -p "🗑️ Attempt to delete S3 paths (s3://${S3_BUCKET}/paimon/, flink/iceberg/, checkpoints/)? (y/N): " -r REPLY </dev/tty
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        echo "  Attempting to delete S3 Fluss/Flink data paths..."
        echo "  Note: This will fail if you don't have s3:ListBucket permission"
        aws s3 rm s3://${S3_BUCKET}/paimon/ --recursive --region ${AWS_REGION:-us-east-2} || true
        aws s3 rm s3://${S3_BUCKET}/flink/iceberg/ --recursive --region ${AWS_REGION:-us-east-2} || true
        aws s3 rm s3://${S3_BUCKET}/checkpoints/ --recursive --region ${AWS_REGION:-us-east-2} || true
        echo "  ⚠️  If you see AccessDenied errors above, manual S3 cleanup is needed"
    else
        echo "  Skipping S3 deletion"
        echo "  ℹ️  Old data may remain in S3. Manual cleanup may be needed."
    fi

    # Clean Glue catalog
    read -p "🗑️ Delete Glue databases and recreate them fresh? (y/N): " -r REPLY </dev/tty
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        echo "  Cleaning Glue catalog..."

        # List and delete all tables in streaming database
        tables=$(aws glue get-tables --database-name streaming --query 'TableList[*].Name' --output text --region ${AWS_REGION:-us-east-2} 2>/dev/null || true)
        if [ -n "$tables" ]; then
            for table in $tables; do
                echo "    Deleting table: streaming.$table"
                aws glue delete-table --database-name streaming --name "$table" --region ${AWS_REGION:-us-east-2} 2>/dev/null || true
            done
        fi

        # List and delete all tables in osb_staging database
        tables=$(aws glue get-tables --database-name osb_staging --query 'TableList[*].Name' --output text --region ${AWS_REGION:-us-east-2} 2>/dev/null || true)
        if [ -n "$tables" ]; then
            for table in $tables; do
                echo "    Deleting table: osb_staging.$table"
                aws glue delete-table --database-name osb_staging --name "$table" --region ${AWS_REGION:-us-east-2} 2>/dev/null || true
            done
        fi

        # Delete the databases
        echo "    Deleting database: streaming"
        aws glue delete-database --name streaming --region ${AWS_REGION:-us-east-2} 2>/dev/null || true

        echo "    Deleting database: osb_staging"
        aws glue delete-database --name osb_staging --region ${AWS_REGION:-us-east-2} 2>/dev/null || true

        # Recreate the databases
        echo "    Creating fresh database: streaming"
        aws glue create-database --database-input '{"Name": "streaming", "Description": "Database for Fluss Iceberg integration"}' --region ${AWS_REGION:-us-east-2} 2>/dev/null || true

        echo "    Creating database: osb_staging"
        aws glue create-database --database-input '{"Name": "osb_staging", "Description": "OSB staging database for Fluss"}' --region ${AWS_REGION:-us-east-2} 2>/dev/null || true
    else
        echo "  Skipping Glue database deletion"

        # Still try to create the databases if they don't exist
        echo "  Ensuring database 'streaming' exists..."
        aws glue create-database --database-input '{"Name": "streaming", "Description": "Database for Fluss Iceberg integration"}' --region ${AWS_REGION:-us-east-2} 2>/dev/null || true

        echo "  Ensuring database 'osb_staging' exists..."
        aws glue create-database --database-input '{"Name": "osb_staging", "Description": "OSB staging database for Fluss"}' --region ${AWS_REGION:-us-east-2} 2>/dev/null || true
    fi

    # Now clean up remote services
    ssh -t "$REMOTE_SERVER" "sudo nix-shell -p jq --run '
        cd $REMOTE_DIR
        set -euo pipefail

        echo \"-----------------------------------\"
        echo \"------- SUBSTEP: CLEANUP ----------\"
        echo \"-----------------------------------\"
        echo \"🛑 Stopping all services...\"

        docker compose -f flink-cdc/docker-compose.yaml down -v || true
        docker compose -f fluss/docker-compose.yaml down -v || true
        docker compose -f postgres-catalog/docker-compose.yaml down -v || true
        docker compose -f postgres-source/docker-compose.yaml down -v || true

        echo \"🧹 Pruning Docker volumes...\"
        docker volume prune -f

        echo \"-----------------------------------------\"
        echo \"------- SUBSTEP: DATA DELETION ----------\"
        echo \"-----------------------------------------\"
        echo \"🗑️ Deleting ALL data directories...\"
        find . -name \"data\" -type d -exec rm -rf {} +

        echo \"----------------------------------------\"
        echo \"------- SUBSTEP: INFRA REBOOT ----------\"
        echo \"----------------------------------------\"
        echo \"🐘 Starting Foundation Services (S3 mode)...\"

        # Always start source postgres
        docker compose -f postgres-source/docker-compose.yaml up -d

        # Only start catalog postgres for Paimon (Iceberg uses Hadoop catalog)
        if [ \"$DATALAKE_FORMAT\" = \"paimon\" ]; then
            echo \"📋 Starting PostgreSQL catalog for Paimon...\"
            docker compose -f postgres-catalog/docker-compose.yaml up -d
        else
            echo \"❄️  Skipping PostgreSQL catalog for Iceberg (uses Hadoop catalog)...\"
        fi

        echo \"⏳ Waiting 3s for PostgreSQL services...\"
        sleep 3
    '"
fi

echo "📤 4. Executing Local Sync and Starting Remote Jobs..."
bash ./sync.sh

# Load local environment for remote execution
source .env

ssh -t "$REMOTE_SERVER" "sudo bash -c '
    cd $REMOTE_DIR

    # Load environment variables
    source .env

    echo \"📋 Copying .env to service directories...\"
    cp .env fluss/.env
    cp .env flink-cdc/.env

    echo \"-------------------------------------------\"
    echo \"------- SUBSTEP: STREAMING LAYER ----------\"
    echo \"-------------------------------------------\"

    echo \"🌊 Starting Fluss & 🐿️ Flink CDC...\"
    docker compose -f fluss/docker-compose.yaml up -d $BUILD_FLAG
    docker compose -f flink-cdc/docker-compose.yaml up -d $BUILD_FLAG

    echo \"⏳ Waiting for Flink JobManager to go live...\"
    until curl -s http://localhost:8081/overview > /dev/null; do sleep 2; done

    echo \"--------------------------------------------\"
    echo \"------- SUBSTEP: REPLICATION TASK ----------\"
    echo \"--------------------------------------------\"
    echo -e \"\n🚀 Running SQL Client: Postgres -> Fluss...\"

    echo \"🚀 Starting Complete CDC Pipeline with Analytics...\"
    cd flink-cdc && bash run.sh

    echo \"--------------------------------------------\"
    echo \"------- SUBSTEP: Tiering service ----------\"
    echo \"--------------------------------------------\"
    echo \"📦 Starting Fluss Tiering Service...\"

    if [ \"\$DATALAKE_FORMAT\" = \"paimon\" ]; then
        docker exec flink-jobmanager /opt/flink/bin/flink run \\
          -Dpipeline.name=\"Fluss Tiering Service\" \\
          -Dparallelism.default=4 \\
          -Dexecution.checkpointing.interval=30s \\
          -Dstate.checkpoints.dir=\"${CHECKPOINTS_DIR}/tiering\" \\
          -Ds3.multiobjectdelete.enable=false \\
          -Dtaskmanager.memory.network.fraction=0.2 \\
          -Dtaskmanager.memory.managed.fraction=0.6 \\
          /opt/flink/lib/fluss-flink-tiering-0.8.0-incubating.jar \\
          --fluss.bootstrap.servers \${HOST_IP}:9123 \\
          --datalake.format paimon \\
          --datalake.paimon.metastore jdbc \\
          --datalake.paimon.uri \"jdbc:postgresql://\${HOST_IP}:\${POSTGRES_CATALOG_PORT}/\${POSTGRES_CATALOG_DB}\" \\
          --datalake.paimon.jdbc.user \${POSTGRES_CATALOG_USER} \\
          --datalake.paimon.jdbc.password \${POSTGRES_CATALOG_PASSWORD} \\
          --datalake.paimon.catalog-key paimon_catalog \\
          --datalake.paimon.warehouse \"\${PAIMON_WAREHOUSE}\" \\
          --datalake.paimon.s3.endpoint \"\$S3_ENDPOINT\" \\
          --datalake.paimon.s3.access-key \"\$S3_ACCESS_KEY\" \\
          --datalake.paimon.s3.secret-key \"\$S3_SECRET_KEY\" \\
          --datalake.paimon.s3.path.style.access \$S3_PATH_STYLE_ACCESS
    else
        docker exec flink-jobmanager /opt/flink/bin/flink run \\
          -Dpipeline.name=\"Fluss Tiering Service\" \\
          -Dparallelism.default=4 \\
          -Dexecution.checkpointing.interval=30s \\
          -Dstate.checkpoints.dir=\"${CHECKPOINTS_DIR}/tiering\" \\
          -Ds3.multiobjectdelete.enable=false \\
          -Dtaskmanager.memory.network.fraction=0.2 \\
          -Dtaskmanager.memory.managed.fraction=0.6 \\
          /opt/flink/lib/fluss-flink-tiering-0.8.0-incubating.jar \\
          --fluss.bootstrap.servers ${HOST_IP}:9123 \\
          --datalake.format iceberg \\
          --datalake.iceberg.type glue \\
          --datalake.iceberg.warehouse \"${ICEBERG_WAREHOUSE}/warehouse\" \\
          --datalake.iceberg.client.region ${AWS_REGION:-us-east-2} \\
          --datalake.iceberg.hadoop.fs.s3a.access.key \"${S3_ACCESS_KEY}\" \\
          --datalake.iceberg.hadoop.fs.s3a.secret.key \"${S3_SECRET_KEY}\"
    fi
'"

echo -e "\n✨ ALL STEPS COMPLETE!"
echo "🗄️  Storage Backend: $STORAGE_TYPE"
echo "📊 Data Lake Format: $DATALAKE_FORMAT"
if [ "$STORAGE_TYPE" = "garage" ]; then
    echo "🏠 Data stored in Garage at: $(grep S3_BASE .env | cut -d'=' -f2)"
else
    echo "☁️  Data stored in S3 at: $(grep S3_BASE .env | cut -d'=' -f2)"
fi